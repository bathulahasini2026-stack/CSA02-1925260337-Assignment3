
#include <stdio.h>

int main()
{
    int a[100], n, i, j, key;

    printf("Enter number of students: ");
    scanf("%d", &n);

    printf("Enter register numbers:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    // Insertion Sort
    for(i = 1; i < n; i++)
    {
        key = a[i];
        j = i - 1;

        while(j >= 0 && a[j] > key)
        {
            a[j + 1] = a[j];
            j--;
        }

        a[j + 1] = key;
    }

    printf("Sorted register numbers:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d ", a[i]);
    }

    return 0;
}
 //PSEUDOCODE

Start.



Read the number of students n.



Read the register numbers into an array.



Repeat from i = 1 to n-1.



Store a[i] in key.



Set j = i - 1.





While j >= 0 and a[j] > key:
- Move a[j] one position right.
- Decrement j.



Insert key at position j + 1.



Display the sorted register numbers.



Stop.

