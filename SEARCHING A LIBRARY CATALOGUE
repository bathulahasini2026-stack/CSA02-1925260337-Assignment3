
#include <stdio.h>

int main()
{
    int a[10], n, key;
    int low, high, mid, i;

    printf("Enter number of books: ");
    scanf("%d", &n);

    printf("Enter accession numbers in sorted order:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter accession number to search: ");
    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while(low <= high)
    {
        mid = (low + high) / 2;

        if(a[mid] == key)
        {
            printf("Book found at position %d", mid + 1);
            return 0;
        }
        else if(a[mid] < key)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    printf("Book not found");

    return 0;
}
