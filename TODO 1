
#include <stdio.h>

int steps;

/* a[] is sorted in ascending order. */
int binary_search(const int a[], int n, int key)
{
    steps = 0;

    int low = 0;
    int high = n - 1;

    while (low <= high)
    {
        int mid = low + (high - low) / 2;

        steps++;

        if (a[mid] == key)
        {
            return mid;
        }
        else if (a[mid] < key)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    return -1;
}

int main(void)
{
    int accession[] = {
        1021, 1048, 1103, 1190, 1222,
        1305, 1377, 1402, 1460, 1533
    };

    int n = sizeof accession / sizeof accession[0];

    int keys[] = {1021, 1305, 1533, 1400};

    for (int k = 0; k < 4; k++)
    {
        int pos = binary_search(accession, n, keys[k]);

        printf("Book %d -> index %d, comparisons = %d\n",
               keys[k], pos, steps);
    }

    return 0;
}

// Pseudocode
1. Initialize steps = 0.
2. Set low = 0 and high = n - 1.
3. Repeat while low <= high.
4. Calculate mid = low + (high - low) / 2.
5. Increment steps.
6. If a[mid] == key, return mid.
7. If a[mid] < key, set low = mid + 1.
8. Otherwise, set high = mid - 1.
9. If the loop ends, return -1.


